# Copy to .env for local development. NEVER commit .env.
JWT_SECRET_KEY=            # required, 32+ chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
GROQ_API_KEY=
GEMINI_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
ENV=dev
DATABASE_PATH=lexirag.db
REDIS_URL=                 # optional
TESSERACT_CMD=             # optional, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe on Windows
OCR_LANGS=eng+hin+kan+tam+tel
